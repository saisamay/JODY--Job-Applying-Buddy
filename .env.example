# Generate private local values with infra/init-env.py (see README).
POSTGRES_PASSWORD=
JODY_OWNER_KEY=
POSTGRES_PORT=55432
REDIS_PORT=56379
API_BASE_URL=http://127.0.0.1:8000
# Optional when using an existing local database or Redis instance:
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:55432/jody
# REDIS_URL=redis://127.0.0.1:56379/0
JODY_DB_APP_PASSWORD=
JODY_ENCRYPTION_KEY=
# Offline by default. Ollama uses installed local models at 127.0.0.1:11434.
JODY_AI_PROVIDER=mock
JODY_CHAT_MODEL=llama3:latest
JODY_EMBED_MODEL=llama3:latest
JODY_AI_DAILY_CALLS=100
# Increment after replacing an installed model behind a mutable tag.
JODY_MODEL_REVISION=1

# Operator-only read checks. Leave blanks until checking that provider.
# DATABASE_URL is the active migration database. Keep Neon rehearsal separate.
JODY_NEON_TEST_DATABASE_URL=
JODY_GOOGLE_CLIENT_ID=
JODY_GOOGLE_CLIENT_SECRET=
JODY_GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/api/v1/integrations/gmail/callback
JODY_GITHUB_TOKEN=
JODY_GITHUB_REPOSITORY=
JODY_RESUME_GIT_REF=
JODY_RESUME_GIT_PATH=
JODY_GEMINI_API_KEY=
JODY_GROQ_API_KEY=
JODY_OPENROUTER_API_KEY=
JODY_OLLAMA_BASE_URL=http://127.0.0.1:11434
JODY_TELEGRAM_BOT_TOKEN=
JODY_NTFY_BASE_URL=
JODY_NTFY_TOKEN=
